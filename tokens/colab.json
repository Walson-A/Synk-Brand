{
  "colab": {
    "$description": "COLAB design tokens (DTCG). SOURCE DE VÉRITÉ — ne jamais éditer src/colab/* à la main, c'est généré : npm run build:tokens. Décisions : design/colab/palette.md + direction.md. Deux couches — 1) ramp = les primitives, une seule teinte 211° ; 2) light/dark = les rôles, qui aliasent la rampe. Changer la rampe re-teinte tout ; changer un rôle ne bouge que lui.",

    "ramp": {
      "$description": "Une seule teinte (211°) en deux saturations. navy = chroma pleine, utilisée en mode clair et pour la marque. slate = 55 % du chroma, utilisée en mode sombre — les couleurs très saturées vibrent sur fond noir.",
      "navy": {
        "50":  { "$type": "color", "$value": "#f3f7fc" },
        "100": { "$type": "color", "$value": "#e3edf7" },
        "200": { "$type": "color", "$value": "#c6d8eb" },
        "300": { "$type": "color", "$value": "#9db9d7" },
        "400": { "$type": "color", "$value": "#6592c3" },
        "500": { "$type": "color", "$value": "#3771ae" },
        "600": { "$type": "color", "$value": "#1f5a98" },
        "700": { "$type": "color", "$value": "#1c4878" },
        "800": { "$type": "color", "$value": "#1B395A", "$description": "La couleur de marque. Valeur fournie par l'owner, figée — les autres étages sont calculés autour d'elle." },
        "900": { "$type": "color", "$value": "#102338" },
        "950": { "$type": "color", "$value": "#091420" },
        "ink": { "$type": "color", "$value": "#070d13" }
      },
      "slate": {
        "50":  { "$type": "color", "$value": "#f5f7fa" },
        "100": { "$type": "color", "$value": "#e8edf3" },
        "200": { "$type": "color", "$value": "#cfd8e3" },
        "300": { "$type": "color", "$value": "#aabaca" },
        "400": { "$type": "color", "$value": "#7a93ae" },
        "500": { "$type": "color", "$value": "#527294" },
        "600": { "$type": "color", "$value": "#3a5b7d" },
        "700": { "$type": "color", "$value": "#314963" },
        "800": { "$type": "color", "$value": "#293a4c" },
        "900": { "$type": "color", "$value": "#19232f" },
        "950": { "$type": "color", "$value": "#0e141b" },
        "ink": { "$type": "color", "$value": "#090d10" }
      },
      "white": { "$type": "color", "$value": "#ffffff" }
    },

    "light": {
      "$description": "Mode par défaut. Fond blanc, action en navy plein.",
      "canvas":        { "$type": "color", "$value": "{colab.ramp.white}" },
      "rail":          { "$type": "color", "$value": "{colab.ramp.navy.50}" },
      "surface":       { "$type": "color", "$value": "{colab.ramp.navy.50}" },
      "chip":          { "$type": "color", "$value": "{colab.ramp.navy.100}" },
      "border":        { "$type": "color", "$value": "{colab.ramp.navy.200}" },
      "text":          { "$type": "color", "$value": "{colab.ramp.navy.950}" },
      "textMuted":     { "$type": "color", "$value": "{colab.ramp.slate.500}", "$description": "Emprunte à la rampe désaturée : moins chromatique, il ne se lit pas comme un lien. 5,01:1 sur blanc." },
      "action":        { "$type": "color", "$value": "{colab.ramp.navy.800}" },
      "onAction":      { "$type": "color", "$value": "{colab.ramp.white}" },
      "brand":         { "$type": "color", "$value": "{colab.ramp.navy.800}" },
      "ring":          { "$type": "color", "$value": "{colab.ramp.navy.800}" },
      "wave":          { "$type": "color", "$value": "{colab.ramp.navy.300}" },
      "wavePlayed":    { "$type": "color", "$value": "{colab.ramp.navy.950}" },
      "hover":         { "$type": "color", "$value": "#eef4fb", "$description": "État d'interaction calibré à la main, pas un étage de rampe : mesuré pour rester perceptible sous du blanc pur (1,107 vs canvas)." },
      "selected":      { "$type": "color", "$value": "{colab.ramp.navy.100}" },
      "selectedHover": { "$type": "color", "$value": "#d7e6f4", "$description": "Idem. 1,073 vs selected — sous le seuil perceptible, d'où la barre latérale qui prend le relais." },
      "danger":        { "$type": "color", "$value": "#b42318", "$description": "6,11:1 sur surface. N'habille QUE l'icône, jamais un fond ni le texte." },
      "success":       { "$type": "color", "$value": "#067647", "$description": "5,29:1 sur surface." },
      "scrim":         { "$type": "color", "$value": "rgba(9,20,32,0.42)" }
    },

    "dark": {
      "$description": "De première classe, pas un repli. Fond quasi noir, carte en navy, action blanche.",
      "canvas":        { "$type": "color", "$value": "{colab.ramp.slate.ink}" },
      "rail":          { "$type": "color", "$value": "#05080a" },
      "surface":       { "$type": "color", "$value": "{colab.ramp.slate.800}" },
      "chip":          { "$type": "color", "$value": "#304254" },
      "border":        { "$type": "color", "$value": "#2f3d4c" },
      "text":          { "$type": "color", "$value": "{colab.ramp.slate.50}" },
      "textMuted":     { "$type": "color", "$value": "{colab.ramp.slate.300}" },
      "action":        { "$type": "color", "$value": "{colab.ramp.white}", "$description": "L'action s'inverse au lieu de prendre une couleur : c'est la zone de contraste maximal de l'écran (19,50:1), donc la plus visible, sans ajouter une teinte." },
      "onAction":      { "$type": "color", "$value": "{colab.ramp.slate.950}" },
      "brand":         { "$type": "color", "$value": "{colab.ramp.navy.800}", "$description": "La marque reste en chroma pleine même en sombre — tuile du logo uniquement." },
      "ring":          { "$type": "color", "$value": "{colab.ramp.slate.50}" },
      "wave":          { "$type": "color", "$value": "{colab.ramp.slate.500}" },
      "wavePlayed":    { "$type": "color", "$value": "{colab.ramp.slate.50}" },
      "hover":         { "$type": "color", "$value": "#141c25" },
      "selected":      { "$type": "color", "$value": "{colab.ramp.slate.800}" },
      "selectedHover": { "$type": "color", "$value": "#32465a" },
      "danger":        { "$type": "color", "$value": "#ef8b84", "$description": "4,82:1 sur surface. La valeur usuelle #f97066 y tombe à 4,18 — écartée pour ça : c'est la CARTE qui contraint, pas le fond." },
      "success":       { "$type": "color", "$value": "#47cd89", "$description": "5,74:1 sur surface." },
      "scrim":         { "$type": "color", "$value": "rgba(0,0,0,0.58)" }
    },

    "font": {
      "sans":   { "$type": "fontFamily", "$value": "'IBM Plex Sans', system-ui, -apple-system, sans-serif", "$description": "IBM Plex Sans, OFL. Web : woff2 variable self-hostée, jamais de CDN. RN : @expo-google-fonts/ibm-plex-sans. Ne remplace PAS Inter côté SYNK — les deux marques cohabitent volontairement (D15)." },
      "weight": {
        "regular":   { "$type": "fontWeight", "$value": 400 },
        "medium":    { "$type": "fontWeight", "$value": 500 },
        "semibold":  { "$type": "fontWeight", "$value": 600 },
        "bold":      { "$type": "fontWeight", "$value": 700 },
        "extrabold": { "$type": "fontWeight", "$value": 800 }
      },
      "size": {
        "label": { "$type": "dimension", "$value": "11px",   "$description": "étiquettes en capitales, horodatages, sous-lignes" },
        "sm":    { "$type": "dimension", "$value": "12.5px", "$description": "méta, libellés de bouton, noms de fichier" },
        "body":  { "$type": "dimension", "$value": "14.5px" },
        "title": { "$type": "dimension", "$value": "15px" },
        "big":   { "$type": "dimension", "$value": "17px" }
      },
      "leading": {
        "tight":  { "$type": "number", "$value": 1.15 },
        "snug":   { "$type": "number", "$value": 1.35 },
        "normal": { "$type": "number", "$value": 1.5 }
      },
      "tracking": {
        "title":  { "$type": "dimension", "$value": "-0.012em" },
        "body":   { "$type": "dimension", "$value": "0" },
        "button": { "$type": "dimension", "$value": "0.1em" },
        "label":  { "$type": "dimension", "$value": "0.13em" }
      }
    },

    "radius": {
      "sm":   { "$type": "dimension", "$value": "8px",   "$description": "puces, avatars de projet, boutons, champs, lignes de liste" },
      "md":   { "$type": "dimension", "$value": "11px",  "$description": "bulles, cartes de fichier" },
      "lg":   { "$type": "dimension", "$value": "14px",  "$description": "conteneurs, modales" },
      "full": { "$type": "dimension", "$value": "999px", "$description": "avatars de personne, badges de non-lus" }
    },

    "space": {
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "10px" },
      "4": { "$type": "dimension", "$value": "12px" },
      "5": { "$type": "dimension", "$value": "14px" },
      "6": { "$type": "dimension", "$value": "18px" },
      "7": { "$type": "dimension", "$value": "20px" },
      "8": { "$type": "dimension", "$value": "24px" }
    },

    "size": {
      "avatar":  { "$type": "dimension", "$value": "27px" },
      "iconSm":  { "$type": "dimension", "$value": "14px", "$description": "dans un bouton à libellé" },
      "iconMd":  { "$type": "dimension", "$value": "16px", "$description": "bouton-icône" },
      "iconLg":  { "$type": "dimension", "$value": "18px", "$description": "inline, message sémantique" },
      "iconXl":  { "$type": "dimension", "$value": "21px", "$description": "rail, navigation" },
      "rail":    { "$type": "dimension", "$value": "246px" },
      "aside":   { "$type": "dimension", "$value": "262px" },
      "waveBar": { "$type": "dimension", "$value": "2px" }
    },

    "border": {
      "width":      { "$type": "dimension", "$value": "1px" },
      "iconStroke": { "$type": "number", "$value": 1.75, "$description": "Tabler Icons. Repli documenté : Lucide. Ne pas mélanger les deux jeux." },
      "selBar":     { "$type": "dimension", "$value": "3px", "$description": "Barre de sélection. Signal de FORME, pas de couleur — indispensable en clair où l'écart de luminance tombe à 1,073." }
    },

    "shadow": {
      "floating": { "$type": "shadow", "$value": "0 8px 24px -6px rgba(9,20,32,0.18)", "$description": "SEULE ombre du système, réservée aux surfaces flottantes (menu, popover, modale) qui doivent se détacher d'un contenu qui défile. Les cartes se définissent par fond + filet — une ombre est invisible sur #090d10." },
      "floatingDark": { "$type": "shadow", "$value": "0 8px 24px -6px rgba(0,0,0,0.72)" }
    },

    "motion": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "base": { "$type": "duration", "$value": "200ms" },
      "ease": { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0, 0, 1)" },
      "disabledOpacity": { "$type": "number", "$value": 0.42 }
    }
  }
}
